package newdemo;

//Multi level Inheritance=> grandparent->parent ->child
class Grandparent{
	int idno=100;
	void disp() {
		System.out.println("Grandparent method is created..");
	}
}

class Parent extends Grandparent{
	
	int rollno=102;
	String name="Raj";
	
	public void show() {
		System.out.println("Parent Class method is created..");
		
		System.out.println("Id no of Grandparent be:"+super.idno);
		System.out.println("Roll no of parent be: "+rollno);
	}
	
}

class Child extends Parent{
	 public void show() {
		 String name="Riya";
		System.out.println("Child class method is created");
		System.out.println("Name of child be:"+super.name);
		System.out.println("Name of current child be:"+name);
		super.show();
	}
	
	 
}


public class Inherit {
	
		public static void main(String[] args) {
		
//		object
		
//			Parent pr=new Parent();
//			pr.show();
//			pr.disp();
			
		Child c=new Child();
		c.show();
		c.disp();
 		
	}

}

package newdemo;

//Method Overriding
class Parent1{
	int money=20000;
	void expenses() {
		System.out.println("Parent Expenses be "+money);

	}
}

class Child1 extends Parent1{
  	void expenses(int cost) {
 		System.out.println("Child expenses be "+cost);
 		
 		System.out.println("Parent expenses details:");
 		super.expenses();
 	}
 
}

public class PolyDemo {

	public static void main(String[] args) {
 
//		method overriding or Run time polymorphism
		Parent1 c=new Child1();
//		c.expenses(30000);
		
		c.expenses();
		
	}
