package newdemo;
//Constructor Overloading
public class Car {
	
	
//	Constructor 
	Car(){
		System.out.println("Default constructor..");
	}
	
	
	Car(int a, int b){
		
		int c=a*b;
		System.out.println("Product:"+c);
 
	
	
	}
	
	
	Car(int x,float d){
		float y=(float)x+d;
		
		System.out.println("Sum:"+y);
		
	}
	
	Car(String name,long price){
		System.out.println("Car BrandName: "+name);
		System.out.println("Car Price: "+price);
	}

	public static void main(String[] args) {
		
//		Constructor overloading - Same name but different signature of parameter
		
		
		Car c=new Car();
		
		Car c1=new Car(10,20);
		
		Car c2=new Car(5,10.3f);
		
		Car c3=new Car("Rolls Royce",10000000L);
 
		
	}

}

